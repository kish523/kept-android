<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below use one policy for cloud backup and phone-to-phone transfer alike.
     Kept never sends receipts to Google Drive, so nothing is backed up here. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
