    <path
        android:fillColor="#FBFAF6"
        android:pathData="M40,28H68A6,6 0,0 1,74 34V78L70,74L66,78L62,74L58,78L54,74L50,78L46,74L42,78L38,74L34,78V34A6,6 0,0 1,40 28Z" />
    <!-- Printed lines -->
    <path
        android:strokeColor="#BFD9CF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M42,38H66M42,44H57" />
    <!-- Check mark -->
    <path
        android:strokeColor="#0F6E56"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M44,56L50.5,62.5L64,49" />
    <!-- Reminder dot, ringed in the background colour -->
    <path
        android:fillColor="#FF8A5C"
        android:strokeColor="#0F6E56"
        android:strokeWidth="3.5"
        android:pathData="M65,31a8,8 0,1 0,16 0a8,8 0,1 0,-16 0Z" />
</vector>
